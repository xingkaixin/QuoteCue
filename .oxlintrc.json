{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "react-perf"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": ["features/host/**/*.{ts,tsx}", "features/host-port/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/annotations", "@/features/annotations/*"],
                "message": "Host layers must not depend on the annotations feature."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [".output/**", ".wxt/**"]
}
