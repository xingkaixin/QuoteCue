{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quotecue-landing",
  "compatibility_date": "2026-08-07",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "quotecue.xingkaixin.me",
      "custom_domain": true,
    },
  ],
}
