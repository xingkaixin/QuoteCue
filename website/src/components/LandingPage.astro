---
import { Faq } from "./Faq";
import InstallActions from "./InstallActions.astro";
import { InteractiveDemo } from "./InteractiveDemo";
import { ThemeToggle } from "./ThemeToggle";
import { getCopy, type Locale } from "../i18n/content";
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const homeUrl = locale === "en" ? "/en/" : "/";
const supportedSites = [
  { name: "ChatGPT", host: "chatgpt.com" },
  { name: "Claude", host: "claude.ai" },
  { name: "DeepSeek", host: "chat.deepseek.com" },
  { name: "Kimi", host: "www.kimi.com" },
];
---

<BaseLayout lang={copy.locale} title={copy.meta.title} description={copy.meta.description}>
  <a
    class="fixed top-3 left-3 z-[100] -translate-y-20 rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-accent-foreground transition-transform focus:translate-y-0"
    href="#main"
  >
    {locale === "en" ? "Skip to content" : "跳到主要内容"}
  </a>

  <header
    class="sticky top-0 z-60 border-b border-line bg-[color-mix(in_srgb,var(--background)_82%,transparent)] backdrop-blur-[14px]"
  >
    <div class="mx-auto flex h-[3.625rem] max-w-[77.25rem] items-center gap-4 px-5 sm:px-7">
      <a
        aria-label="QuoteCue"
        class="font-display mr-auto flex items-center gap-2.5 text-[1.0625rem] font-bold tracking-[-0.01em]"
        href={homeUrl}
      >
        <img
          src="/brand/quotecue-icon-128.png"
          width="26"
          height="26"
          alt=""
          fetchpriority="high"
        />
        QuoteCue
      </a>

      <nav aria-label={locale === "en" ? "Main navigation" : "主导航"} class="hidden md:block">
        <ul class="flex list-none items-center gap-5 p-0 text-[0.84375rem] text-muted">
          <li><a class="transition-colors hover:text-foreground" href="#demo">{copy.nav.demo}</a></li>
          <li>
            <a class="transition-colors hover:text-foreground" href="#features">
              {copy.nav.features}
            </a>
          </li>
          <li>
            <a class="transition-colors hover:text-foreground" href="#privacy">
              {copy.nav.privacy}
            </a>
          </li>
          <li><a class="transition-colors hover:text-foreground" href="#faq">{copy.nav.faq}</a></li>
        </ul>
      </nav>

      <div class="flex items-center gap-1.5">
        <a
          aria-label={copy.alternateLanguageLabel}
          class="font-mono flex h-8 items-center rounded-full border border-line px-3 text-[0.71875rem] text-muted outline-none transition-colors hover:border-muted hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring"
          href={copy.alternateLanguageUrl}
          hreflang={locale === "en" ? "zh-CN" : "en"}
        >
          {copy.alternateLanguage}
        </a>
        <ThemeToggle client:load label={copy.themeLabel} />
      </div>
    </div>
  </header>

  <main id="main">
    <section
      class="relative mx-auto max-w-[77.25rem] overflow-hidden px-5 pt-20 pb-10 sm:px-7 sm:pt-24"
    >
      <div
        aria-hidden="true"
        class="font-display pointer-events-none absolute -top-12 -right-10 select-none text-[28rem] leading-[0.8] font-bold text-accent opacity-[0.07]"
      >
        “
      </div>
      <div class="font-mono relative mb-6 flex items-center gap-2 text-xs text-muted">
        <span class="size-1.5 rounded-full bg-accent"></span>
        {copy.hero.eyebrow}
      </div>

      <h1
        class="font-display relative m-0 max-w-[15ch] text-[clamp(2.75rem,7.2vw,6rem)] leading-[1.02] font-bold tracking-[-0.035em] text-balance"
      >
        {copy.hero.before}<br />
        <span class="hero-mark">{copy.hero.highlight}</span>{copy.hero.after}
        <span
          aria-hidden="true"
          class="animate-pop ml-2 inline-flex size-[1.375rem] translate-y-[-0.3em] items-center justify-center rounded-full bg-accent font-sans text-xs leading-none font-semibold tracking-normal text-accent-foreground shadow-[0_0_0_2px_var(--panel),0_8px_20px_rgb(0_0_0/32%)]"
        >
          1
        </span>
      </h1>

      <p class="relative mt-7 mb-9 max-w-[58ch] text-[1.09375rem] leading-[1.62] text-muted">
        {copy.hero.description}
      </p>

      <InstallActions
        chromeLabel={copy.hero.chrome}
        edgeLabel={copy.hero.edge}
        chromeUrl={copy.links.chrome}
        edgeUrl={copy.links.edge}
        note={copy.hero.note}
      />
    </section>

    <section class="mx-auto max-w-[77.25rem] scroll-mt-20 px-5 pt-15 pb-10 sm:px-7" id="demo">
      <div class="mb-2 flex flex-wrap items-baseline gap-3.5">
        <h2 class="font-display m-0 text-[clamp(1.625rem,3.4vw,2.5rem)] font-bold tracking-[-0.025em]">
          {copy.demo.title}
        </h2>
        <span class="font-mono text-xs text-accent">{copy.demo.liveLabel}</span>
      </div>
      <p class="mt-0 mb-6 max-w-[62ch] text-[0.96875rem] leading-[1.6] text-muted">
        {copy.demo.intro}
      </p>
      <InteractiveDemo client:visible copy={copy.demo} />
    </section>

    <section
      class="mx-auto max-w-[77.25rem] scroll-mt-20 px-5 py-[4.375rem] sm:px-7"
      id="features"
    >
      <h2 class="font-display mt-0 mb-8 text-[clamp(1.625rem,3.4vw,2.5rem)] font-bold tracking-[-0.025em]">
        {copy.features.title}
      </h2>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(17.5rem,100%),1fr))] gap-[1.125rem]">
        {
          copy.features.items.map((feature) => (
            <article class="rounded-2xl border border-line bg-panel p-6">
              <h3 class="font-display mt-0 mb-2.5 text-lg font-semibold tracking-[-0.01em]">
                {feature.title}
              </h3>
              <p class="m-0 text-[0.90625rem] leading-[1.65] text-muted">{feature.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mx-auto max-w-[77.25rem] px-5 pt-5 pb-[4.375rem] sm:px-7">
      <div class="rounded-[1.25rem] border border-line bg-panel p-6 sm:p-8">
        <p class="font-mono mt-0 mb-5 text-xs text-muted">{copy.supported.label}</p>
        <ul
          class="grid list-none grid-cols-[repeat(auto-fit,minmax(10rem,1fr))] gap-5 p-0"
          aria-label={copy.supported.label}
        >
          {
            supportedSites.map((site) => (
              <li class="flex flex-col gap-1.5">
                <span class="font-display text-[1.3125rem] font-semibold">{site.name}</span>
                <span class="font-mono text-xs text-muted">{site.host}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section
      class="mx-auto max-w-[77.25rem] scroll-mt-20 px-5 pb-20 sm:px-7"
      id="privacy"
    >
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(18.75rem,100%),1fr))] items-start gap-10">
        <div>
          <h2 class="font-display mt-0 mb-4 text-[clamp(1.625rem,3.4vw,2.5rem)] font-bold tracking-[-0.025em]">
            {copy.privacy.title[0]}<br />{copy.privacy.title[1]}
          </h2>
          <p class="m-0 max-w-[58ch] text-[0.96875rem] leading-[1.7] text-muted">
            {copy.privacy.description}
          </p>
        </div>
        <dl class="m-0 flex flex-col gap-px overflow-hidden rounded-[0.875rem] border border-line bg-line">
          {
            copy.privacy.facts.map((fact) => (
              <div class="grid grid-cols-[4.625rem_1fr] items-baseline gap-4 bg-panel px-5 py-4">
                <dt class="font-mono text-xs text-accent">{fact.label}</dt>
                <dd class="m-0 text-sm leading-[1.6] text-muted">{fact.body}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="mx-auto max-w-[56.25rem] scroll-mt-20 px-5 pb-20 sm:px-7" id="faq">
      <h2 class="font-display mt-0 mb-7 text-[clamp(1.625rem,3.4vw,2.5rem)] font-bold tracking-[-0.025em]">
        {copy.faq.title}
      </h2>
      <Faq client:visible items={copy.faq.items} />
    </section>

    <section class="mx-auto max-w-[77.25rem] px-5 pb-[5.625rem] sm:px-7">
      <div class="relative overflow-hidden rounded-3xl border border-line bg-panel p-[clamp(2.25rem,6vw,4.5rem)]">
        <div
          aria-hidden="true"
          class="font-display pointer-events-none absolute -right-7 -bottom-40 select-none text-[21.25rem] leading-[0.8] font-bold text-accent opacity-[0.08]"
        >
          ”
        </div>
        <h2 class="font-display relative mt-0 mb-4 max-w-[18ch] text-[clamp(1.75rem,4.4vw,3.25rem)] font-bold tracking-[-0.03em]">
          {copy.closing.title}
        </h2>
        <p class="relative mt-0 mb-8 max-w-[52ch] text-base leading-[1.65] text-muted">
          {copy.closing.description}
        </p>
        <div class="relative flex flex-wrap items-center gap-3">
          <InstallActions
            chromeLabel={copy.hero.chrome}
            edgeLabel={copy.hero.edge}
            chromeUrl={copy.links.chrome}
            edgeUrl={copy.links.edge}
            compact
          />
          <a
            class="inline-flex h-[3.125rem] items-center gap-2 rounded-full border border-line px-6 text-[0.9375rem] font-medium text-muted outline-none transition-colors hover:border-muted hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring max-sm:w-full max-sm:justify-center"
            href={copy.links.github}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2A10 10 0 0 0 8.84 21.5c.5.09.68-.22.68-.48l-.01-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.36 1.09 2.94.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85l-.01 2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"></path>
            </svg>
            GitHub
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-line px-5 py-7 text-[0.8125rem] text-muted sm:px-7">
    <div class="mx-auto flex max-w-[73.75rem] flex-wrap items-center gap-4">
      <img src="/brand/quotecue-icon-128.png" width="20" height="20" alt="" loading="lazy" />
      <span>QuoteCue</span>
      <div class="ml-auto flex flex-wrap items-center justify-end gap-x-4 gap-y-2 max-sm:ml-0 max-sm:w-full max-sm:justify-start">
        <a
          class="transition-colors hover:text-foreground"
          href={copy.links.privacy}
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.footer.privacy}
        </a>
        <a
          class="transition-colors hover:text-foreground"
          href={copy.links.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.footer.github}
        </a>
        <a class="font-mono text-[0.71875rem]" href="mailto:xingkaixin@gmail.com">
          xingkaixin@gmail.com
        </a>
      </div>
    </div>
  </footer>
</BaseLayout>
