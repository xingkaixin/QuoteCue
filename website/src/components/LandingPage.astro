---
import { Faq } from "./Faq";
import { CueFlowField } from "./CueFlowField";
import InstallActions from "./InstallActions.astro";
import { InteractiveDemo } from "./InteractiveDemo";
import { LanguageSwitcher } from "./LanguageSwitcher";
import ProductUpdates from "./ProductUpdates.astro";
import { ThemeToggle } from "./ThemeToggle";
import { getCopy } from "../i18n/content";
import { WEBSITE_LOCALE_CONFIG, WEBSITE_LOCALES, type Locale } from "../i18n/locales";
import {
  getProductUpdates,
  LATEST_PRODUCT_UPDATE_DATE,
} from "../i18n/product-updates";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SUPPORTED_SITES } from "@quotecue/shared/supported-sites";
import focusArtwork from "../assets/artwork/focus-convergence.avif";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const updates = getProductUpdates(locale);
const labels = {
  "zh-CN": {
    live: "实时演示 / 浏览器内",
    hint: "↘ 选中任意一句",
    convergence: "多条批注 / 一次追问",
    context: "上下文，准确保留",
    privacy: "不收集，才是真隐私",
    details: "细节 / 没有小字",
    ready: "当回答还不够",
    scene: {
      answerLabel: "AI 回答",
      answerLead: "三天可以按区域来分，能省下不少路上的时间。",
      selectionOne: "八点前到清水寺，人最少。",
      answerBridge: "第二天去岚山，第三天再前往伏见稻荷和宇治。",
      selectionTwo: "这一天步行距离不短。",
      noteLabel: "我的批注",
      noteOne: "我九点才能出发，顺序怎么调？",
      noteTwo: "把步行控制在一小时内。",
      compileLabel: "2 条批注已整理",
      compileText: "结合这两个限制，重新调整行程",
      caption: "选中文字 · 写下限制 · 一次追问",
    },
  },
  en: {
    live: "LIVE / IN BROWSER",
    hint: "↘ SELECT ANY SENTENCE",
    convergence: "MANY NOTES / ONE MOVE",
    context: "CONTEXT, KEPT PRECISE",
    privacy: "PRIVATE BY ABSENCE",
    details: "DETAILS / NO FINE PRINT",
    ready: "READY WHEN THE ANSWER ISN'T",
    scene: {
      answerLabel: "AI answer",
      answerLead: "Split the three days by area to spend less time in transit.",
      selectionOne: "Reach Kiyomizu-dera before 8 a.m.",
      answerBridge: "Visit Arashiyama on day two, then Fushimi Inari and Uji on day three.",
      selectionTwo: "Expect a long day of walking.",
      noteLabel: "My note",
      noteOne: "I can only start at 9. What should move?",
      noteTwo: "Keep walking under one hour.",
      compileLabel: "2 notes organized",
      compileText: "Adjust the itinerary around both constraints",
      caption: "SELECT TEXT · ADD CONTEXT · ASK ONCE",
    },
  },
  ja: {
    live: "ライブ / ブラウザ内",
    hint: "↘ 文を選択してください",
    convergence: "複数の注釈 / 1 回の質問",
    context: "文脈を正確に保持",
    privacy: "収集しないプライバシー",
    details: "詳細 / 細則なし",
    ready: "回答が足りないときに",
    scene: {
      answerLabel: "AI の回答",
      answerLead: "エリアごとに分けると、移動時間を抑えられます。",
      selectionOne: "清水寺には午前 8 時前に到着。",
      answerBridge: "2 日目は嵐山、3 日目は伏見稲荷と宇治へ向かいます。",
      selectionTwo: "この日は歩く距離が長めです。",
      noteLabel: "コメント",
      noteOne: "9 時出発なら、順番をどう変える？",
      noteTwo: "歩く時間を 1 時間以内に。",
      compileLabel: "2 件の注釈を整理",
      compileText: "2 つの条件に合わせて旅程を調整",
      caption: "文章を選択 · 条件を追加 · 一度で質問",
    },
  },
}[locale];
const pagePath = WEBSITE_LOCALE_CONFIG[locale].path;
const pageUrl = new URL(pagePath, Astro.site).href;
const organizationId = new URL("/#organization", Astro.site).href;
const softwareId = new URL("/#software", Astro.site).href;
const websiteId = new URL("/#website", Astro.site).href;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: new URL("/", Astro.site).href,
      name: "QuoteCue",
      inLanguage: WEBSITE_LOCALES,
      publisher: { "@id": organizationId },
    },
    {
      "@type": "Organization",
      "@id": organizationId,
      name: "QuoteCue",
      url: new URL("/", Astro.site).href,
      logo: new URL("/brand/quotecue-icon-512.png", Astro.site).href,
      email: "xingkaixin@gmail.com",
      sameAs: [copy.links.github],
    },
    {
      "@type": "SoftwareApplication",
      "@id": softwareId,
      name: "QuoteCue",
      url: pageUrl,
      description: copy.meta.description,
      applicationCategory: "BrowserApplication",
      applicationSubCategory: "Browser extension",
      browserRequirements: "Google Chrome or Microsoft Edge",
      operatingSystem: "ChromeOS, Linux, macOS, Windows",
      inLanguage: copy.locale,
      isAccessibleForFree: true,
      downloadUrl: [copy.links.chrome, copy.links.edge],
      featureList: copy.features.items.map((feature) => feature.title),
      softwareVersion: updates.items[0].version,
      releaseNotes: updates.items[0].summary,
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
      },
      author: { "@id": organizationId },
    },
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: copy.meta.title,
      description: copy.meta.description,
      dateModified: LATEST_PRODUCT_UPDATE_DATE,
      inLanguage: copy.locale,
      isPartOf: { "@id": websiteId },
      about: { "@id": softwareId },
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      mainEntity: copy.faq.items.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    },
  ],
};
---

<BaseLayout
  lang={copy.locale}
  title={copy.meta.title}
  description={copy.meta.description}
  socialImageAlt={copy.meta.socialImageAlt}
  structuredData={structuredData}
>
  <a
    class="skip-link"
    href="#main"
  >
    {copy.skipToContent}
  </a>

  <header class="site-header">
    <div class="site-shell header-inner">
      <a
        aria-label="QuoteCue"
        class="brand-lockup"
        href={pagePath}
      >
        <img
          src="/brand/quotecue-icon-128.png"
          width="26"
          height="26"
          alt=""
          fetchpriority="high"
        />
        <span>QuoteCue</span>
      </a>

      <nav aria-label={copy.mainNavigationLabel} class="main-nav">
        <ul>
          <li><a href="#demo">{copy.nav.demo}</a></li>
          <li><a href="#features">{copy.nav.features}</a></li>
          <li><a href="#updates">{copy.nav.updates}</a></li>
          <li><a href="#privacy">{copy.nav.privacy}</a></li>
        </ul>
      </nav>

      <div class="header-actions">
        <LanguageSwitcher
          client:load
          currentLocale={locale}
          label={copy.languageSwitcherLabel}
        />
        <ThemeToggle client:load label={copy.themeLabel} />
        <a
          class="header-install"
          href={copy.links.chrome}
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.hero.chrome}
        </a>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="site-shell hero-section">
      <div class="hero-copy">
        <p class="signal-label">
          <span aria-hidden="true"></span>
          {copy.hero.eyebrow}
        </p>

        <h1>
          <span>{copy.hero.before}</span>
          <span class="hero-highlight">{copy.hero.highlight}</span>
          <span>{copy.hero.after}</span>
        </h1>

        <p class="hero-description">{copy.hero.description}</p>

        <InstallActions
          chromeLabel={copy.hero.chrome}
          edgeLabel={copy.hero.edge}
          chromeUrl={copy.links.chrome}
          edgeUrl={copy.links.edge}
          note={copy.hero.note}
        />
      </div>

      <div class="hero-visual" role="img" aria-label={copy.meta.socialImageAlt}>
        <CueFlowField client:load />
        <div aria-hidden="true" class="product-scene">
          <div class="scene-answer-window">
            <div class="scene-window-bar">
              <span class="scene-window-site">ChatGPT</span>
              <span>{labels.scene.answerLabel}</span>
            </div>
            <div class="scene-question">{copy.demo.userMessage}</div>
            <div class="scene-answer">
              <span class="scene-avatar">AI</span>
              <div class="scene-answer-copy">
                <p>{labels.scene.answerLead}</p>
                <p class="scene-selected-sentence">
                  <mark>{labels.scene.selectionOne}</mark>
                  <span class="scene-selection-badge">1</span>
                </p>
                <p>{labels.scene.answerBridge}</p>
                <p class="scene-selected-sentence">
                  <mark>{labels.scene.selectionTwo}</mark>
                  <span class="scene-selection-badge">2</span>
                </p>
              </div>
            </div>
          </div>

          <div class="scene-note scene-note-one">
            <div><span>01</span>{labels.scene.noteLabel}</div>
            <p>{labels.scene.noteOne}</p>
          </div>

          <div class="scene-note scene-note-two">
            <div><span>02</span>{labels.scene.noteLabel}</div>
            <p>{labels.scene.noteTwo}</p>
          </div>

          <div class="scene-composer">
            <div class="scene-annotation-stack"><span>01</span><span>02</span></div>
            <div class="scene-compiled-copy">
              <small>{labels.scene.compileLabel}</small>
              <p>{labels.scene.compileText}</p>
            </div>
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
              <path d="M9 13V5m0 0L5.5 8.5M9 5l3.5 3.5" stroke="currentColor" stroke-width="1.5"></path>
            </svg>
          </div>
        </div>
        <p class="visual-caption" aria-hidden="true">{labels.scene.caption}</p>
      </div>
    </section>

    <section class="site-shell host-rail" aria-label={copy.supported.label}>
      <p>{copy.supported.label}</p>
      <ul>
        {
          SUPPORTED_SITES.map((site) => (
            <li>
              <span>{site.name}</span>
              <small>{site.hostname}</small>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="site-shell section-grid demo-section" id="demo">
      <header class="section-intro">
        <p class="section-kicker">{labels.live}</p>
        <h2>{copy.demo.title}</h2>
        <p>{copy.demo.intro}</p>
        <span class="interaction-hint" aria-hidden="true">{labels.hint}</span>
      </header>
      <div class="demo-stage">
        <InteractiveDemo client:visible copy={copy.demo} />
      </div>
    </section>

    <section class="convergence-section">
      <div class="convergence-image">
        <img
          src={focusArtwork.src}
          width={focusArtwork.width}
          height={focusArtwork.height}
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="convergence-copy">
        <p class="section-kicker">{labels.convergence}</p>
        <h2>{copy.features.items[2].title}</h2>
        <p>{copy.features.items[2].body}</p>
      </div>
    </section>

    <section class="site-shell features-section" id="features">
      <header class="feature-heading">
        <p class="section-kicker">{labels.context}</p>
        <h2>{copy.features.title}</h2>
      </header>
      <div class="feature-grid">
        {
          copy.features.items.map((feature) => (
            <article class="feature-card">
              <span class="annotation-bracket" aria-hidden="true"></span>
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <ProductUpdates copy={updates} />

    <section class="site-shell privacy-section" id="privacy">
      <div class="privacy-statement">
        <p class="section-kicker">{labels.privacy}</p>
        <h2>
          {copy.privacy.title[0]}<br />{copy.privacy.title[1]}
        </h2>
        <p>{copy.privacy.description}</p>
      </div>
      <dl class="privacy-facts">
        {
          copy.privacy.facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.body}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="site-shell faq-section" id="faq">
      <div class="faq-heading">
        <p class="section-kicker">{labels.details}</p>
        <h2>{copy.faq.title}</h2>
      </div>
      <div class="faq-list">
        <Faq client:visible items={copy.faq.items} />
      </div>
    </section>

    <section class="site-shell closing-section">
      <div class="closing-orbit" aria-hidden="true"><span></span></div>
      <div class="closing-copy">
        <p class="section-kicker">{labels.ready}</p>
        <h2>{copy.closing.title}</h2>
        <p>{copy.closing.description}</p>
        <div class="closing-actions">
          <InstallActions
            chromeLabel={copy.hero.chrome}
            edgeLabel={copy.hero.edge}
            chromeUrl={copy.links.chrome}
            edgeUrl={copy.links.edge}
            compact
          />
          <a
            class="github-link"
            href={copy.links.github}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2A10 10 0 0 0 8.84 21.5c.5.09.68-.22.68-.48l-.01-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.36 1.09 2.94.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85l-.01 2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"></path>
            </svg>
            GitHub
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="site-shell footer-inner">
      <img src="/brand/quotecue-icon-128.png" width="20" height="20" alt="" loading="lazy" />
      <span>QuoteCue</span>
      <span class="footer-line" aria-hidden="true"></span>
      <span>{copy.hero.note}</span>
    </div>
  </footer>
</BaseLayout>
