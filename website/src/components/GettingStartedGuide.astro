---
import { compileAnnotationPrompt } from "@quotecue/shared/annotation-prompt";
import { annotationPromptMessagesFor } from "@quotecue/shared/annotation-prompt-messages";
import { SUPPORTED_SITES } from "@quotecue/shared/supported-sites";
import { getCopy } from "../i18n/content";
import { GUIDE_COPY } from "../i18n/getting-started";
import { FOCUSED_FOLLOW_UP_COPY } from "../i18n/focused-follow-up";
import type { Locale } from "../i18n/locales";
import { websitePagePath } from "../i18n/pages";
import GuideLayout from "../layouts/GuideLayout.astro";
import InstallActions from "./InstallActions.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = GUIDE_COPY[locale];
const landing = getCopy(locale);

const prompt = compileAnnotationPrompt(
  copy.annotations.map((entry, index) => ({ ...entry, ordinal: index + 1 })),
  "",
  annotationPromptMessagesFor(locale),
);
---

<GuideLayout locale={locale} page="guide" title={copy.title} description={copy.description} intro={copy.intro} label={copy.label}>
  <ol class="guide-steps">
    {copy.steps.map((step, index) => (
      <li>
        <h2><span class="guide-step-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>{step.title}</h2>
        <p>{step.body}</p>
        {index === 0 && <InstallActions placement="guide" chromeLabel={landing.hero.chrome} edgeLabel={landing.hero.edge} chromeUrl={landing.links.chrome} edgeUrl={landing.links.edge} desktopNote={landing.hero.desktopNote} compact />}
      </li>
    ))}
  </ol>
  <section aria-labelledby="example-title">
    <h2 id="example-title">{copy.example}</h2>
    <ol class="guide-examples">
      {copy.annotations.map((entry) => (
        <li>
          <dl>
            <dt>{copy.selectedText}</dt>
            <dd><q>{entry.selectedText}</q></dd>
            <dt>{copy.comment}</dt>
            <dd>{entry.comment}</dd>
          </dl>
        </li>
      ))}
    </ol>
    <h3>{copy.output}</h3>
    <p>{copy.outputIntro}</p>
    <pre class="guide-prompt">{prompt}</pre>
  </section>
  <section>
    <h2>{copy.recovery}</h2>
    <p>{copy.recoveryBody}</p>
    <h3>{copy.troubleshooting}</h3>
    <p>{copy.troubleshootingBody}</p>
  </section>
  <section>
    <h2>{copy.platforms}</h2>
    <p>{copy.platformsBody}</p>
    <ul>
      {SUPPORTED_SITES.map((site) => <li><a href={`https://${site.hostname}/`}>{site.name} · {site.hostname}</a></li>)}
    </ul>
  </section>
  <section>
    <h2>{copy.privacy}</h2>
    <p>{copy.privacyBody}</p>
  </section>
  <section>
    <h2>{FOCUSED_FOLLOW_UP_COPY[locale].related}</h2>
    <a href={websitePagePath(locale, "focusedFollowUp")}>{FOCUSED_FOLLOW_UP_COPY[locale].title}</a>
  </section>
</GuideLayout>
