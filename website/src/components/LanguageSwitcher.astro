---
import { CaretDownIcon } from "@phosphor-icons/react/dist/ssr/CaretDown";
import { TranslateIcon } from "@phosphor-icons/react/dist/ssr/Translate";
import { WEBSITE_LOCALE_CONFIG, WEBSITE_LOCALES, type Locale } from "../i18n/locales";

interface Props {
  currentLocale: Locale;
  label: string;
}

const { currentLocale, label } = Astro.props;
---

<label class="relative inline-flex items-center text-muted">
  <TranslateIcon aria-hidden="true" className="pointer-events-none absolute left-3" size={14} weight="bold" />
  <select
    aria-label={label}
    data-language-switcher
    class="font-mono h-8 cursor-pointer appearance-none rounded-full border border-line bg-transparent pr-8 pl-8 text-xs font-medium text-muted outline-none transition-colors hover:border-muted hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background motion-reduce:transition-none"
  >
    {WEBSITE_LOCALES.map((locale) => (
      <option value={WEBSITE_LOCALE_CONFIG[locale].path} selected={locale === currentLocale} lang={locale}>
        {WEBSITE_LOCALE_CONFIG[locale].label}
      </option>
    ))}
  </select>
  <CaretDownIcon aria-hidden="true" className="pointer-events-none absolute right-3" size={12} weight="bold" />
</label>

<script>
  for (const select of document.querySelectorAll<HTMLSelectElement>("[data-language-switcher]")) {
    select.addEventListener("change", () => {
      window.location.assign(select.value);
    });
  }
</script>
