---
import "../styles/global.css";
import {
  DEFAULT_WEBSITE_LOCALE,
  WEBSITE_LOCALE_CONFIG,
  WEBSITE_LOCALES,
  type Locale,
} from "../i18n/locales";

interface Props {
  lang: Locale;
  title: string;
  description: string;
  socialImageAlt: string;
  canonicalPath?: string;
  indexable?: boolean;
  structuredData?: Record<string, unknown>;
}

const {
  lang,
  title,
  description,
  socialImageAlt,
  canonicalPath = WEBSITE_LOCALE_CONFIG[lang].path,
  indexable = true,
  structuredData,
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site);
const localeAlternates = WEBSITE_LOCALES.map((locale) => ({
  locale,
  url: new URL(WEBSITE_LOCALE_CONFIG[locale].path, Astro.site),
}));
const alternateOgLocales = WEBSITE_LOCALES.filter((locale) => locale !== lang).map(
  (locale) => WEBSITE_LOCALE_CONFIG[locale].ogLocale,
);
const defaultUrl = new URL(WEBSITE_LOCALE_CONFIG[DEFAULT_WEBSITE_LOCALE].path, Astro.site);
const socialImageUrl = new URL("/og-cover.png", Astro.site);
const analyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN;
const jsonLd = structuredData ? JSON.stringify(structuredData).replaceAll("<", "\\u003c") : null;
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0e0e10" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f4f5" media="(prefers-color-scheme: light)" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={indexable ? "index, follow, max-image-preview:large" : "noindex, nofollow"}
    />
    {indexable && <link rel="canonical" href={canonicalUrl} />}
    {
      indexable &&
        localeAlternates.map(({ locale, url }) => (
          <link rel="alternate" hreflang={locale} href={url} />
        ))
    }
    {indexable && <link rel="alternate" hreflang="x-default" href={defaultUrl} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {
      indexable && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="QuoteCue" />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonicalUrl} />
          <meta property="og:locale" content={WEBSITE_LOCALE_CONFIG[lang].ogLocale} />
          {alternateOgLocales.map((locale) => (
            <meta property="og:locale:alternate" content={locale} />
          ))}
          <meta property="og:image" content={socialImageUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta
            property="og:image:alt"
            content={socialImageAlt}
          />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={socialImageUrl} />
          <meta
            name="twitter:image:alt"
            content={socialImageAlt}
          />
        </>
      )
    }
    <title>{title}</title>
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem("quotecue-theme");
        const systemTheme = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        document.documentElement.dataset.theme = savedTheme ?? systemTheme;
      } catch {
        document.documentElement.dataset.theme = "dark";
      }
    </script>
  </head>
  <body>
    <slot />
    {
      analyticsToken && (
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      )
    }
  </body>
</html>
